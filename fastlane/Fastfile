lane :deploySandboxFirebase do
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
  
  # Verify build artifact exists (path relative to fastlane/ directory)
  ipa_path = "builds/sandbox/firebase/ExampleApp-Sandbox.ipa"
  unless File.exist?(ipa_path)
    UI.user_error!("Build artifact not found at #{ipa_path}. Please run buildReleaseSandboxFirebase first.")
  end
  
  # Convert to absolute path for upload actions
  ipa_absolute_path = File.absolute_path(ipa_path)
  
  # Get version from project and build number from build_numbers.json
  # Use absolute path since get_version_number doesn't handle relative paths with .. well
  xcodeproj_path = File.expand_path("../ExampleApp/ExampleApp.xcodeproj", __dir__)
  version = get_version_number(
    xcodeproj: xcodeproj_path,
    target: "ExampleApp",
    configuration: "Release (Sandbox)"
  )
  # Read build number from build_numbers.json (source of truth)
  build_number = get_build_number_from_file(
    version: version,
    environment: "sandbox"
  ) || get_build_number(xcodeproj: xcodeproj_path) # Fallback to project if not found
  
  UI.message("📦 Deploying Sandbox Firebase build: #{ipa_absolute_path}")
  UI.message("Version: #{version} (#{build_number})")
  
  # Prepare release notes with version info
  commit_message = ENV["CI_COMMIT_MESSAGE"] || "Sandbox Firebase build from CI/CD"
  release_notes = "Version: #{version} (Build #{build_number})\n\n#{commit_message}"
  
  # Upload to Firebase App Distribution using service account (recommended, doesn't expire)
  # Fallback to CLI token for backward compatibility (deprecated)
  if ENV["FIREBASE_APP_ID_SANDBOX"]
    UI.message("🔥 Uploading to Firebase App Distribution...")
    
    # Prefer service account file (recommended method)
    if ENV["FIREBASE_SERVICE_ACCOUNT_FILE"]
      service_account_file = ensure_firebase_service_account_file("FIREBASE_SERVICE_ACCOUNT_FILE")
      unless service_account_file
        UI.user_error!("FIREBASE_SERVICE_ACCOUNT_FILE is set but could not be resolved to a file path")
      end
      
      firebase_app_distribution(
        app: ENV["FIREBASE_APP_ID_SANDBOX"],
        ipa_path: ipa_absolute_path,
        groups: ENV["FIREBASE_TESTER_GROUPS"] || "internal-testers",
        release_notes: release_notes,
        service_credentials_file: service_account_file
      )
      UI.success("✅ Successfully uploaded to Firebase App Distribution (using service account)")
    # Fallback to CLI token (deprecated, expires after ~1 day)
    elsif ENV["FIREBASE_TOKEN"]
      UI.important("⚠️ Using deprecated FIREBASE_TOKEN. Consider migrating to FIREBASE_SERVICE_ACCOUNT_FILE")
      firebase_app_distribution(
        app: ENV["FIREBASE_APP_ID_SANDBOX"],
        ipa_path: ipa_absolute_path,
        groups: ENV["FIREBASE_TESTER_GROUPS"] || "internal-testers",
        release_notes: release_notes,
        firebase_cli_token: ENV["FIREBASE_TOKEN"]
      )
      UI.success("✅ Successfully uploaded to Firebase App Distribution (using CLI token)")
    else
      UI.user_error!("Neither FIREBASE_SERVICE_ACCOUNT_FILE nor FIREBASE_TOKEN is set. Please configure Firebase authentication.")
    end
  else
    UI.user_error!("FIREBASE_APP_ID_SANDBOX not set, cannot deploy to Firebase")
  end
  
  UI.success("🚀 Sandbox Firebase deployment completed successfully!")
  UI.message("Deployed version: #{version} (#{build_number})")
end

