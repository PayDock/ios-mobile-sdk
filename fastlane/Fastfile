default_platform :ios

# Fastlane runs all built in actions from one directory above where the Fastfile lives 
# so make sure all the paths are relative in that regard.

require 'json'
require 'rexml/document'
require 'fileutils'

# --- Code Quality Lanes ---

desc "Static analysis of the project. Configure the options in .swiftlint.yml"
lane :lint do
  # Ensure fastlane directory exists
  FileUtils.mkdir_p("fastlane")
  
  # Lint entire project (includes all packages)
  # SwiftLint automatically discovers and lints all Swift files recursively
  swiftlint(
    mode: :lint,
    config_file: ".swiftlint.yml",
    strict: true,
    reporter: "codeclimate",
    output_file: "fastlane/swiftlint_report.json",
    raise_if_swiftlint_error: true
  )
end

# --- Test Lanes ---

desc "Runs all the unit tests and UI Tests"
desc "Configure the .env.default file in this directory before you run the test or build lanes."
desc "Info on the .env files and how to use them can be found here: https://github.com/fastlane/fastlane/blob/master/fastlane/docs/Advanced.md#environment-variables"
lane :test do
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "240"
  
  # Run ExampleApp tests
  # Ensure test_output directory exists
  FileUtils.mkdir_p("fastlane/test_output")
  
  run_tests(
    project: "ExampleApp/ExampleApp.xcodeproj",
    scheme: "ExampleApp",
    configuration: "Debug (Staging)",
    destination: "platform=iOS Simulator,name=iPhone 17,OS=26.2",
    only_testing: [
      "ExampleAppTests"
    ],
    xcargs: "SWIFTPM_ENABLE_PLUGINS=1 SWIFTPM_ENABLE_COMMAND_PLUGINS=1",
    result_bundle: true,
    output_types: "junit",
    output_directory: "fastlane/test_output"
  )
  
  # Run tests for all packages
  test_all_packages
end

private_lane :test_all_packages do
  packages = [
    { name: "CommonModels", scheme: "CommonModelsPackageTests" },
    { name: "DataCharges", scheme: "DataChargesPackageTests" },
    { name: "DataCustomer", scheme: "DataCustomerPackageTests" },
    { name: "DataGateways", scheme: "DataGatewaysPackageTests" },
    { name: "DataMPGS3ds", scheme: "DataMPGS3dsPackageTests" },
    { name: "DataPaymentSources", scheme: "DataPaymentSourcesPackageTests" },
    { name: "DataStandalone3ds", scheme: "DataStandalone3dsPackageTests" },
    { name: "DataVault", scheme: "DataVaultPackageTests" }
  ]
  
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
  
  packages.each do |package|
    package_path = "#{package[:name]}/Package.swift"
    if File.exist?(package_path)
      UI.message("Running tests for #{package[:name]}...")
      
      Dir.chdir(package[:name]) do
        begin
          run_tests(
            package_path: ".",
            scheme: package[:scheme],
            destination: "platform=iOS Simulator,name=iPhone 17,OS=26.2",
            xcargs: "SWIFTPM_ENABLE_PLUGINS=1 SWIFTPM_ENABLE_COMMAND_PLUGINS=1",
            result_bundle: true,
            code_coverage: true,
            output_types: "junit",
            output_directory: "fastlane/test_output"
          )
          
          # Copy test report to main test_output directory
          package_report = "fastlane/test_output/report.junit"
          if File.exist?(package_report)
            main_report_dir = "../fastlane/test_output"
            FileUtils.mkdir_p(main_report_dir)
            FileUtils.cp(package_report, "#{main_report_dir}/#{package[:name]}_report.junit")
          end
        rescue => e
          UI.important("⚠️ Tests failed for #{package[:name]}: #{e.message}")
          # Continue with other packages
        end
      end
    else
      UI.important("⚠️ No Package.swift found for #{package[:name]}, skipping")
    end
  end
  
  # Merge all JUnit reports
  merge_junit_reports
end

private_lane :merge_junit_reports do
  packages = ["CommonModels", "DataCharges", "DataCustomer", "DataGateways", "DataMPGS3ds", "DataPaymentSources", "DataStandalone3ds", "DataVault"]
  
  # Start with ExampleApp report
  main_report_path = "fastlane/test_output/report.junit"
  merged_testsuites = []
  
  # Read main ExampleApp report
  if File.exist?(main_report_path)
    begin
      main_doc = REXML::Document.new(File.read(main_report_path))
      main_doc.root.elements.each("testsuite") do |testsuite|
        merged_testsuites << testsuite
      end
    rescue => e
      UI.important("⚠️ Failed to parse main test report: #{e.message}")
    end
  end
  
  # Merge each package report
  packages.each do |package|
    package_report_path = "fastlane/test_output/#{package}_report.junit"
    if File.exist?(package_report_path)
      begin
        package_doc = REXML::Document.new(File.read(package_report_path))
        package_doc.root.elements.each("testsuite") do |testsuite|
          merged_testsuites << testsuite
        end
      rescue => e
        UI.important("⚠️ Failed to merge report for #{package}: #{e.message}")
      end
    end
  end
  
  # Create merged document
  merged_doc = REXML::Document.new
  testsuites_elem = merged_doc.add_element("testsuites")
  
  # Add all testsuites
  merged_testsuites.each do |testsuite|
    testsuites_elem.add_element(testsuite)
  end
  
  # Write merged report
  FileUtils.mkdir_p(File.dirname(main_report_path))
  File.write(main_report_path, merged_doc.to_s)
  UI.success("✅ Merged test reports from all packages (#{merged_testsuites.length} test suites)")
end
  
lane :testPackage do
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
  run_tests(
    package_path: ".",
    scheme: "MobileSDK",
    destination: "platform=iOS Simulator,name=iPhone 17,OS=26.2",
    xcargs: "SWIFTPM_ENABLE_PLUGINS=1 SWIFTPM_ENABLE_COMMAND_PLUGINS=1",
    result_bundle: true,
    code_coverage: true,
    output_types: "junit",
    output_directory: "fastlane/test_output"
  )
end

# --- Bin File Management Lanes ---
# Mirrors caching logic from BinDataCacheManager: Last-Modified preferred, ETag fallback

# CloudFront URL for BIN validation file (same as BinDataCacheManager.CLOUDFRONT_URL)
BIN_DATA_URL = "https://d25lng5khxpk7i.cloudfront.net/bin-data-au-v1.json"
# Local asset filename (same as BinDataCacheManager.ASSET_FILENAME)
BIN_LOCAL_FILENAME = "card-schemes.json"
# Asset path relative to repository root (BinProcessing SPM package)
BIN_ASSET_PATH = "BinProcessing/Sources/BinProcessing/Resources/JSON/#{BIN_LOCAL_FILENAME}"

desc "Fetch BIN validation file from CloudFront using HTTP caching headers"
lane :fetch_bin_file do
    require 'net/http'
    require 'uri'
    require 'fileutils'

    UI.header("BIN File Fetch - Starting")
    UI.message("=" * 60)
    UI.message("CloudFront URL: #{BIN_DATA_URL}")
    UI.message("Local filename: #{BIN_LOCAL_FILENAME}")
    UI.message("Asset path: #{BIN_ASSET_PATH}")
    UI.message("Working directory: #{Dir.pwd}")
    UI.message("=" * 60)

    # Get stored cache headers from CI variables (may be empty on first run)
    stored_last_modified = ENV['BIN_FILE_LAST_MODIFIED']
    stored_etag = ENV['BIN_FILE_ETAG']

    UI.header("Stored CI Variables")
    UI.message("BIN_FILE_LAST_MODIFIED: #{stored_last_modified || '(not set)'}")
    UI.message("BIN_FILE_ETAG: #{stored_etag || '(not set)'}")

    uri = URI.parse(BIN_DATA_URL)
    UI.message("Connecting to: #{uri.host}:#{uri.port} (SSL: true)")
    
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = true
    http.open_timeout = 30
    http.read_timeout = 60

    # HEAD request to check cache headers (mirrors BinDataCacheManager.fetchRemoteCacheHeaders)
    UI.header("HEAD Request")
    UI.message("Performing HEAD request to: #{uri.request_uri}")
    head_request = Net::HTTP::Head.new(uri.request_uri)
    head_response = http.request(head_request)

    UI.message("HEAD Response Code: #{head_response.code}")
    UI.message("HEAD Response Headers:")
    head_response.each_header { |k, v| UI.message("  #{k}: #{v}") }

    if head_response.code != "200"
        UI.error("HEAD request failed with status #{head_response.code}")
        raise "Failed to check remote BIN file status"
    end

    remote_last_modified = head_response['Last-Modified']
    remote_etag = head_response['ETag']

    UI.header("Cache Header Comparison")
    UI.message("Remote Last-Modified: #{remote_last_modified || '(none)'}")
    UI.message("Stored Last-Modified: #{stored_last_modified || '(none)'}")
    UI.message("Remote ETag: #{remote_etag || '(none)'}")
    UI.message("Stored ETag: #{stored_etag || '(none)'}")

    # Determine if download is needed (mirrors BinDataCacheManager.shouldDownloadFullFile logic)
    UI.header("Download Decision Logic")
    should_download = false
    decision_reason = ""
    
    if remote_last_modified
        # Last-Modified preferred
        should_download = (remote_last_modified != stored_last_modified)
        decision_reason = "Last-Modified comparison: '#{remote_last_modified}' != '#{stored_last_modified}' => #{should_download}"
        UI.message("Using Last-Modified (preferred)")
        UI.message("  Remote: '#{remote_last_modified}'")
        UI.message("  Stored: '#{stored_last_modified}'")
        UI.message("  Match: #{remote_last_modified == stored_last_modified}")
    elsif remote_etag
        # ETag fallback
        should_download = (remote_etag != stored_etag)
        decision_reason = "ETag comparison: '#{remote_etag}' != '#{stored_etag}' => #{should_download}"
        UI.message("Using ETag (fallback, no Last-Modified)")
        UI.message("  Remote: '#{remote_etag}'")
        UI.message("  Stored: '#{stored_etag}'")
        UI.message("  Match: #{remote_etag == stored_etag}")
    else
        # No headers available, download if no stored values
        should_download = stored_last_modified.nil? && stored_etag.nil?
        decision_reason = "No remote headers, stored values nil: #{should_download}"
        UI.message("No cache headers from remote")
        UI.message("  Stored Last-Modified nil: #{stored_last_modified.nil?}")
        UI.message("  Stored ETag nil: #{stored_etag.nil?}")
    end

    UI.important("DECISION: should_download = #{should_download}")
    UI.message("Reason: #{decision_reason}")

    # Create bin_schema directory for artifacts at repository root (not in fastlane/)
    # Fastlane runs from fastlane/ directory, so we need to go up one level
    bin_schema_dir = "../bin_schema"
    FileUtils.mkdir_p(bin_schema_dir)
    UI.message("Created bin_schema directory at: #{File.expand_path(bin_schema_dir)}")

    if should_download
        UI.header("Downloading BIN File")
        UI.message("Performing GET request...")
        get_request = Net::HTTP::Get.new(uri.request_uri)
        get_response = http.request(get_request)

        UI.message("GET Response Code: #{get_response.code}")

        if get_response.code != "200"
            UI.error("GET request failed with status #{get_response.code}")
            raise "Failed to download BIN file"
        end

        # Save the downloaded file
        bin_content = get_response.body
        bin_file_path = "#{bin_schema_dir}/#{BIN_LOCAL_FILENAME}"
        File.write(bin_file_path, bin_content)
        UI.message("Saved BIN file to: #{File.expand_path(bin_file_path)}")
        UI.message("File size: #{bin_content.length} bytes")

        # Save the cache headers for the commit lane
        # These will be updated in CI variables after successful commit
        File.write("#{bin_schema_dir}/last_modified.txt", remote_last_modified || "")
        File.write("#{bin_schema_dir}/etag.txt", remote_etag || "")
        File.write("#{bin_schema_dir}/should_commit.txt", "true")

        UI.message("Saved metadata files:")
        UI.message("  last_modified.txt: '#{remote_last_modified || ''}'")
        UI.message("  etag.txt: '#{remote_etag || ''}'")
        UI.message("  should_commit.txt: 'true'")

        UI.success("BIN file downloaded successfully (#{bin_content.length} bytes)")
    else
        UI.header("Skipping Download")
        UI.message("Remote file unchanged, no download needed")
        # Still save current headers for reference
        File.write("#{bin_schema_dir}/last_modified.txt", stored_last_modified || "")
        File.write("#{bin_schema_dir}/etag.txt", stored_etag || "")
        File.write("#{bin_schema_dir}/should_commit.txt", "false")

        UI.message("Saved metadata files:")
        UI.message("  last_modified.txt: '#{stored_last_modified || ''}'")
        UI.message("  etag.txt: '#{stored_etag || ''}'")
        UI.message("  should_commit.txt: 'false'")
    end

    UI.header("BIN File Fetch - Complete")
end

desc "Commit card schemes file to repository if it has changed"
lane :commit_bin_file do
    require 'fileutils'

    UI.header("BIN File Commit - Starting")
    UI.message("=" * 60)
    UI.message("Working directory: #{Dir.pwd}")
    UI.message("Branch: #{ENV['CI_COMMIT_REF_NAME']}")
    UI.message("Project ID: #{ENV['CI_PROJECT_ID']}")
    UI.message("=" * 60)

    # Check if fetch indicated a commit is needed
    # bin_schema is at repository root, Fastlane runs from fastlane/ directory
    UI.header("Checking Fetch Artifacts")
    bin_schema_dir = "../bin_schema"
    should_commit_file = "#{bin_schema_dir}/should_commit.txt"
    
    UI.message("Looking for artifacts in: #{File.expand_path(bin_schema_dir)}")
    
    unless File.exist?(should_commit_file)
        UI.error("#{should_commit_file} not found. Did fetch_bin_file run?")
        UI.message("Checking directory...")
        UI.message("  #{bin_schema_dir}/ exists: #{File.directory?(bin_schema_dir)}")
        if File.directory?(bin_schema_dir)
            UI.message("  Contents: #{Dir.glob("#{bin_schema_dir}/*").join(', ')}")
        end
        raise "Required artifact not found"
    end
    
    UI.message("Found should_commit.txt at: #{File.expand_path(should_commit_file)}")

    should_commit_value = File.read(should_commit_file).strip
    should_commit = should_commit_value == "true"
    UI.message("should_commit.txt content: '#{should_commit_value}'")
    UI.message("should_commit (parsed): #{should_commit}")

    unless should_commit
        UI.important("No changes to commit (remote file unchanged)")
        UI.header("BIN File Commit - Skipped")
        next
    end

    # Locate the fetched bin file
    UI.header("Locating Downloaded BIN File")
    bin_file_path = "#{bin_schema_dir}/#{BIN_LOCAL_FILENAME}"
    
    unless File.exist?(bin_file_path)
        UI.error("Error: #{BIN_LOCAL_FILENAME} not found at #{bin_file_path}")
        UI.message("Directory contents of #{bin_schema_dir}/:")
        Dir.glob("#{bin_schema_dir}/*").each { |f| UI.message("  #{f}") } rescue nil
        raise "Required file #{bin_file_path} not found"
    end

    UI.message("Found bin file: #{File.expand_path(bin_file_path)}")
    UI.message("Bin file size: #{File.size(bin_file_path)} bytes")
    UI.message("Target branch: #{ENV['CI_COMMIT_REF_NAME']}")

    # Determine the correct path for mobile-sdk assets (check if exists locally)
    UI.header("Checking Existing Asset File")
    assets_file_path = nil
    if File.exist?(BIN_ASSET_PATH)
        assets_file_path = BIN_ASSET_PATH
        UI.message("Found existing asset at: #{BIN_ASSET_PATH}")
    elsif File.exist?("../#{BIN_ASSET_PATH}")
        assets_file_path = "../#{BIN_ASSET_PATH}"
        UI.message("Found existing asset at: ../#{BIN_ASSET_PATH}")
    else
        UI.message("No existing asset file found locally")
        UI.message("  Checked: #{BIN_ASSET_PATH}")
        UI.message("  Checked: ../#{BIN_ASSET_PATH}")
    end

    # Check if the file has changed or needs to be created
    if assets_file_path && File.exist?(assets_file_path)
        UI.message("Existing asset file size: #{File.size(assets_file_path)} bytes")
        
        # Compare files using Ruby's FileUtils (avoids shell exit code issues)
        UI.header("Comparing Files")
        bin_content = File.read(bin_file_path)
        asset_content = File.read(assets_file_path)
        files_different = (bin_content != asset_content)
        
        UI.message("Downloaded file size: #{bin_content.length} bytes")
        UI.message("Existing asset size: #{asset_content.length} bytes")
        UI.message("Files are #{files_different ? 'DIFFERENT' : 'IDENTICAL'}")
        
        if files_different
            UI.header("Committing Update")
            UI.message("Card schemes file has changed, committing update via GitLab API...")
            commit_file_via_api(
                file_path: bin_file_path,
                commit_message: "Update card schemes from CloudFront [skip ci]"
            )
            update_bin_cache_variables
            UI.success("Update committed successfully")
        else
            UI.important("Card schemes file content is identical, no commit needed")
        end
    else
        UI.header("Creating New Asset File")
        UI.message("Card schemes file not found in assets, creating via GitLab API...")
        commit_file_via_api(
            file_path: bin_file_path,
            commit_message: "Add card schemes file from CloudFront [skip ci]"
        )
        update_bin_cache_variables
        UI.success("New file created successfully")
    end

    UI.header("BIN File Commit - Complete")
end

# Updates the BIN_FILE_LAST_MODIFIED and BIN_FILE_ETAG CI variables
# after a successful commit
private_lane :update_bin_cache_variables do
    UI.header("Updating CI Cache Variables")
    
    # bin_schema is at repository root, Fastlane runs from fastlane/ directory
    bin_schema_dir = "../bin_schema"
    last_modified_file = "#{bin_schema_dir}/last_modified.txt"
    etag_file = "#{bin_schema_dir}/etag.txt"

    UI.message("Reading metadata files:")
    UI.message("  last_modified.txt: #{File.expand_path(last_modified_file)}")
    UI.message("  etag.txt: #{File.expand_path(etag_file)}")

    new_last_modified = File.read(last_modified_file).strip rescue ""
    new_etag = File.read(etag_file).strip rescue ""

    UI.message("Values to update:")
    UI.message("  BIN_FILE_LAST_MODIFIED: '#{new_last_modified}'")
    UI.message("  BIN_FILE_ETAG: '#{new_etag}'")

    if new_last_modified.length > 0
        UI.message("Updating BIN_FILE_LAST_MODIFIED CI variable...")
        begin
            update_gitlab_ci_variable(key: "BIN_FILE_LAST_MODIFIED", value: new_last_modified)
            UI.success("BIN_FILE_LAST_MODIFIED updated to: #{new_last_modified}")
        rescue => e
            UI.error("Failed to update BIN_FILE_LAST_MODIFIED: #{e.message}")
            UI.message("Note: Variable may not exist yet. Create it manually in GitLab CI/CD settings.")
        end
    else
        UI.message("Skipping BIN_FILE_LAST_MODIFIED update (empty value)")
    end

    if new_etag.length > 0
        UI.message("Updating BIN_FILE_ETAG CI variable...")
        begin
            update_gitlab_ci_variable(key: "BIN_FILE_ETAG", value: new_etag)
            UI.success("BIN_FILE_ETAG updated to: #{new_etag}")
        rescue => e
            UI.error("Failed to update BIN_FILE_ETAG: #{e.message}")
            UI.message("Note: Variable may not exist yet. Create it manually in GitLab CI/CD settings.")
        end
    else
        UI.message("Skipping BIN_FILE_ETAG update (empty value)")
    end

    UI.message("CI variable update complete")
end

# Update a CI variable in GitLab.
#
# @param key [String] the name of the CI variable to update
# @param value [String, Integer] the new value for the CI variable
def update_gitlab_ci_variable(key:, value:)
    gitlab_token = ENV["GITLAB_TOKEN"]
    unless gitlab_token
        UI.user_error!("Missing GITLAB_TOKEN environment variable")
    end

    project_id = ENV["CI_PROJECT_ID"]
    unless project_id
        UI.user_error!("Missing CI_PROJECT_ID environment variable")
    end

    api_endpoint = ENV["CI_API_V4_URL"]
    unless api_endpoint
        UI.user_error!("Missing CI_API_V4_URL environment variable")
    end

    api_url = "#{api_endpoint}/projects/#{project_id}/variables/#{key}"

    # Build JSON payload properly to handle special characters (e.g., quotes in ETag values)
    payload = { "value" => value.to_s, "variable_type" => "env_var" }.to_json
    
    # Write payload to temp file to avoid shell escaping issues
    require 'tempfile'
    tmp = Tempfile.new(["gitlab_var_", ".json"])
    begin
        tmp.write(payload)
        tmp.flush
        response = sh("curl -s --show-error --request PUT --header 'Content-Type: application/json' --header 'PRIVATE-TOKEN: #{gitlab_token}' \
            --data @#{tmp.path} \
            '#{api_url}'", log: false)
    ensure
        tmp.close!
    end

    # check if the command was successful.
    parsed_response = JSON.parse(response)
    if parsed_response["key"] != key
        UI.user_error!("Error setting GitLab variable: #{key}")
    end
end

private_lane :commit_file_via_api do |options|
    file_path = options[:file_path]
    commit_message = options[:commit_message]
    
    UI.message("Encoding file to base64: #{file_path}")
    # Base64 encode the new file content (macOS compatible, log: false to avoid filling CI logs)
    new_content = sh("base64 -i #{file_path}", log: false).strip.gsub(/\n/, '')
    UI.message("Base64 encoded content length: #{new_content.length} characters")

    # Check if assets file exists (in current or parent directory)
    assets_exists = File.exist?(BIN_ASSET_PATH) || File.exist?("../#{BIN_ASSET_PATH}")
    
    # URL-encoded path for GitLab API
    file_path_encoded = BIN_ASSET_PATH.gsub("/", "%2F")
    
    if assets_exists
        # Update existing file
        UI.message("Getting current file info from GitLab API...")
        
        # Use project path as fallback if project ID doesn't work
        project_identifier = ENV['CI_PROJECT_ID'] || "paydock%2Fbounded-contexts%2Fmobile%2Fmobile-sdk-ios"
        api_url = "#{ENV['CI_API_V4_URL']}/projects/#{project_identifier}/repository/files/#{file_path_encoded}?ref=#{ENV['CI_COMMIT_REF_NAME']}"

        # Make call
        gitlab_token = ENV['GITLAB_TOKEN']
        current_file_info = sh("curl -s -w '\\nHTTP_CODE:%{http_code}' --header \"PRIVATE-TOKEN: #{gitlab_token}\" '#{api_url}'").strip
        
        # Split response and HTTP code
        response_parts = current_file_info.split("\nHTTP_CODE:")
        response_body = response_parts[0]
        http_code = response_parts[1] if response_parts.length > 1
        
        UI.message("GitLab API (get file) HTTP Status: #{http_code}")
        
        # Check for authentication errors
        if http_code == "401"
            UI.error("Authentication failed. Possible issues:")
            UI.error("  1. GITLAB_TOKEN is invalid or expired")
            UI.error("  2. Token doesn't have 'api' or 'write_repository' scope")
            UI.error("  3. Token is for wrong project/group")
            raise "GitLab API authentication failed (401 Unauthorized)"
        elsif http_code == "404"
            UI.error("File not found. This might be the first time creating the file.")
            # Handle as new file creation instead
            assets_exists = false
        elsif http_code != "200"
            UI.error("GitLab API returned HTTP #{http_code}")
            raise "GitLab API error: HTTP #{http_code}"
        end
        
        # Only proceed with update logic if we still have assets_exists = true
        if assets_exists
            # Parse the response to get the SHA
            begin
                file_data = JSON.parse(response_body)
                # GitLab API returns 'last_commit_id' for the commit SHA, not 'content_sha'
                current_sha = file_data['last_commit_id']
                
                if current_sha.nil?
                    UI.error("Error: Could not get current file commit SHA. Response: #{response_body}")
                    UI.error("Available fields: #{file_data.keys.join(', ')}")
                    raise "Failed to get file commit SHA"
                end
            
                UI.message("Current file SHA: #{current_sha}")
                
                # Commit the file update via GitLab API
                UI.message("Updating file via GitLab API...")
                update_url = "#{ENV['CI_API_V4_URL']}/projects/#{project_identifier}/repository/files/#{file_path_encoded}"
                
                update_data = {
                    branch: ENV['CI_COMMIT_REF_NAME'],
                    content: new_content,
                    encoding: "base64",
                    commit_message: commit_message,
                    last_commit_id: current_sha
                }.to_json
                
                # Write JSON to temp file to avoid embedding large base64 in shell command
                # This prevents CI log overflow (4MB limit)
                require 'tempfile'
                update_tmp = Tempfile.new(["gitlab_update_", ".json"])
                begin
                    update_tmp.write(update_data)
                    update_tmp.flush
                    update_response_raw = sh("curl -s -w '\\nHTTP_CODE:%{http_code}' --request PUT --header \"PRIVATE-TOKEN: #{gitlab_token}\" --header 'Content-Type: application/json' --data @#{update_tmp.path} '#{update_url}'", log: false).strip
                ensure
                    update_tmp.close!
                end
                
                # Split response and HTTP code
                update_parts = update_response_raw.split("\nHTTP_CODE:")
                update_response = update_parts[0]
                update_http_code = update_parts[1] if update_parts.length > 1
                
                UI.message("Update HTTP Status Code: #{update_http_code}")
                
                # Check for HTTP errors first
                if update_http_code != "200"
                    UI.error("GitLab API returned HTTP #{update_http_code} for file update")
                    UI.error("Response: #{update_response}")
                    raise "GitLab API error: HTTP #{update_http_code}"
                end
                
                # Check if the update was successful
                # GitLab API returns file_path and branch on success (not commit_id)
                begin
                    response_data = JSON.parse(update_response)
                    if response_data['file_path'] && response_data['branch']
                        UI.success("Card schemes file updated and committed successfully via GitLab API")
                        UI.message("Updated file: #{response_data['file_path']} on branch: #{response_data['branch']}")
                    elsif response_data['error'] || response_data['message']
                        UI.error("Error: GitLab API error. Response: #{update_response}")
                        raise "GitLab API error: #{response_data['error'] || response_data['message']}"
                    else
                        UI.error("Error: Unexpected response format. Response: #{update_response}")
                        raise "Failed to update file"
                    end
                rescue JSON::ParserError
                    UI.error("Error: Invalid JSON response. Response: #{update_response}")
                    raise "Invalid API response"
                end
                
            rescue JSON::ParserError
                UI.error("Error: Could not parse file info response. Response: #{response_body}")
                raise "Failed to parse API response"
            end
        end
    end
    
    unless assets_exists
        # Create new file
        UI.message("Creating file via GitLab API...")
        project_identifier = ENV['CI_PROJECT_ID'] || "paydock%2Fbounded-contexts%2Fmobile%2Fmobile-sdk-ios"
        create_url = "#{ENV['CI_API_V4_URL']}/projects/#{project_identifier}/repository/files/#{file_path_encoded}"
        
        create_data = {
            branch: ENV['CI_COMMIT_REF_NAME'],
            content: new_content,
            encoding: "base64",
            commit_message: commit_message
        }.to_json
        
        gitlab_token = ENV['GITLAB_TOKEN']
        
        # Write JSON to temp file to avoid embedding large base64 in shell command
        # This prevents CI log overflow (4MB limit)
        require 'tempfile'
        create_tmp = Tempfile.new(["gitlab_create_", ".json"])
        begin
            create_tmp.write(create_data)
            create_tmp.flush
            create_response = sh("curl -s -w '\\nHTTP_CODE:%{http_code}' --request POST --header \"PRIVATE-TOKEN: #{gitlab_token}\" --header 'Content-Type: application/json' --data @#{create_tmp.path} '#{create_url}'", log: false).strip
        ensure
            create_tmp.close!
        end
        
        # Split response and HTTP code for create operation
        create_parts = create_response.split("\nHTTP_CODE:")
        create_body = create_parts[0]
        create_http_code = create_parts[1] if create_parts.length > 1
        
        UI.message("Create HTTP Status Code: #{create_http_code}")
        UI.message("Create API Response: #{create_body}")
        
        # Check for authentication errors in create operation
        if create_http_code == "401"
            UI.error("Authentication failed during file creation.")
            raise "GitLab API authentication failed (401 Unauthorized)"
        elsif create_http_code != "201"
            UI.error("GitLab API returned HTTP #{create_http_code} for file creation")
            raise "GitLab API error: HTTP #{create_http_code}"
        end
        
        # Check if the creation was successful
        # GitLab API returns file_path and branch on success (not commit_id)
        begin
            response_data = JSON.parse(create_body)
            if response_data['file_path'] && response_data['branch']
                UI.success("Card schemes file created and committed successfully via GitLab API")
                UI.message("Created file: #{response_data['file_path']} on branch: #{response_data['branch']}")
            elsif response_data['error'] || response_data['message']
                UI.error("Error: GitLab API error. Response: #{create_body}")
                raise "GitLab API error: #{response_data['error'] || response_data['message']}"
            else
                UI.error("Error: Unexpected response format. Response: #{create_body}")
                raise "Failed to create file"
            end
        rescue JSON::ParserError
            UI.error("Error: Invalid JSON response. Response: #{create_body}")
            raise "Invalid API response"
        end
    end
end

