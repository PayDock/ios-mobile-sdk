  # Get current version from project
  current_version = get_version_number(
    xcodeproj: "ExampleApp/ExampleApp.xcodeproj",
    target: "ExampleApp",
    configuration: "Release (Sandbox)"
  )
  
  # Read build number from file (shared with TestFlight build)
  # Build number should have been set by prepareSandbox lane
  build_number = get_build_number_from_file(
    version: current_version,
    environment: "sandbox"
  )
  
  if build_number.nil?
    UI.user_error!("Build number not found for version #{current_version} (sandbox). Please run prepareSandbox first.")
  end
  
  build_info = { version: current_version, build_number: build_number }
  
  # Update version and build number in Xcode project
  update_version_and_build_number(
    project: "ExampleApp/ExampleApp.xcodeproj",
    target: "ExampleApp",
    version: build_info[:version],
    build_number: build_info[:build_number]
  )
  
  # Inject environment variables from GitLab into Sandbox.xcconfig
  # Use absolute path since Fastlane runs from fastlane/ directory
  xcconfig_path = File.expand_path("../ExampleApp/ExampleApp/Configs/Sandbox.xcconfig", __dir__)
  inject_env_vars_to_xcconfig(
    xcconfig_path: xcconfig_path,
    env_suffix: "_SANDBOX"
  )
  
  # Disable automatic code signing and configure manual signing for Release (Sandbox) only
  # Using Ad Hoc profiles for Firebase App Distribution (allows direct download)
  update_code_signing_settings(
    use_automatic_signing: false,
    path: "ExampleApp/ExampleApp.xcodeproj",
    targets: ["ExampleApp"],
    build_configurations: ["Release (Sandbox)"],
    code_sign_identity: "iPhone Distribution",
    bundle_identifier: "com.paydock.multitenant.sandbox",
    profile_name: "match AdHoc com.paydock.multitenant.sandbox",
    team_id: "4DX7V3HMRJ"
  )
  
  # Build the app only (no deployment)
  # Using ad-hoc export method for Firebase App Distribution
  # Note: TestFlight requires app-store export method, so TestFlight uploads will fail with this build
  build_app(
	project: "ExampleApp/ExampleApp.xcodeproj",
	scheme: "ExampleApp Sandbox", 
	configuration: "Release (Sandbox)",
	export_method: "ad-hoc",
	output_directory: "fastlane/builds/sandbox/firebase",
	output_name: "ExampleApp-Sandbox",
	skip_build_archive: false,
	xcargs: "-skipPackagePluginValidation -skipMacroValidation DEVELOPMENT_TEAM=4DX7V3HMRJ",
	export_options: {
	  method: "ad-hoc",
	  provisioningProfiles: {
	    "com.paydock.multitenant.sandbox" => "match AdHoc com.paydock.multitenant.sandbox"
	  }
	}
  )
  
  UI.success("✅ Sandbox Firebase build completed successfully!")
  UI.message("Build artifact: fastlane/builds/sandbox/firebase/ExampleApp-Sandbox.ipa")
  UI.message("Version: #{build_info[:version]} (#{build_info[:build_number]})")
end

