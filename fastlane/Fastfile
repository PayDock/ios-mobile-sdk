end

# Prepares build number for staging environment (shared between Firebase and TestFlight)
lane :prepareStaging do
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
  
  # Get current version from project
  current_version = get_version_number(
    xcodeproj: "ExampleApp/ExampleApp.xcodeproj",
    target: "ExampleApp",
    configuration: "Release (Staging)"
  )
  
  # Manage build number (increments per version) - shared for both Firebase and TestFlight
  build_info = manage_build_number(
    version: current_version,
    environment: "staging"
  )
  
  UI.success("✅ Staging build number prepared: #{build_info[:version]} (#{build_info[:build_number]})")
  UI.message("This build number will be used for both Firebase and TestFlight builds")
end

