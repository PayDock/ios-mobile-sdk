lane :buildDebugStaging do
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
  build_app(
	project: "ExampleApp/ExampleApp.xcodeproj",
	scheme: "ExampleApp Staging", 
	configuration: "Debug (Staging)"
  )
