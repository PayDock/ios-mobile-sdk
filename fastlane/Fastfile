# --- Release Lanes ---

desc "Creates and pushes a tag on GitLab"
lane :tag_release do
    # This lane automates the process of creating and pushing a tag to the GitLab repository.
    # It extracts the version number from the unified helper function.

    # Get the version name using the unified helper function
    version_tag = get_version_tag()

    # Configure Git user (if needed).
    sh("git config --global user.email \"john.costello@paydock.com\"") # Sets the Git user email.
    sh("git config --global user.name \"jpcostello\"") # Sets the Git user name.
    # The 'sh' action is used to execute shell commands.

    # Create and push the tag.
    sh("git tag -a #{version_tag} -m \"Release version #{version_tag}\"") # Creates an annotated Git tag.
    #   - '-a': Creates an annotated tag.
    #   - '#{version_tag}': The tag name (e.g., "1.0.0").
    #   - '-m': Specifies the tag message.

    # Use a temporary credential helper script to avoid token exposure in logs
    credential_script = "/tmp/git_credential_#{Process.pid}"
    
    begin
        # Create a temporary credential helper script
        File.write(credential_script, <<~SCRIPT)
          #!/bin/bash
          echo "username=gitlab-ci-token"
          echo "password=#{ENV['GITLAB_TOKEN']}"
        SCRIPT
        
        # Make the script executable
        File.chmod(0700, credential_script)
        
        # Push the tag using the temporary credential helper
        sh("git -c credential.helper= -c credential.helper='#{credential_script}' push origin #{version_tag}")
        
    ensure
        # Always clean up the temporary file
        File.delete(credential_script) if File.exist?(credential_script)
    end
end

desc "Creates a release on GitLab"
lane :create_gitlab_release do |options|
    # This lane automates the process of creating a release on GitLab.
    # It is designed to be triggered when a new tag is pushed to the 'release' branch.

    # Get the version tag using the unified helper function
    version_tag = get_version_tag(options)

    # Ensure a version tag is available; otherwise, raise an error.
    if version_tag == "unknown"
        UI.user_error!("No version tag could be determined. Ensure you pass 'version' as an option, set CI_COMMIT_TAG, or have git tags available.")
    end

    # Extract information from environment variables.
    # These variables are typically set by the CI/CD pipeline.
    tag_name = ENV["CI_COMMIT_TAG"] # The tag name from the CI/CD environment.
    project_id = ENV["CI_PROJECT_ID"] # The project ID from the CI/CD environment.
    gitlab_token = ENV["GITLAB_TOKEN"] # The GitLab API token from the CI/CD environment.
    api_endpoint = ENV["CI_API_V4_URL"] # The GitLab API endpoint from the CI/CD environment.

    # Read the changelog file to get the release notes for the specified version.
    changelog_notes = get_release_notes(version_tag)

    # Construct the release details.
    # This includes the release name and a description that includes the changelog notes.
    release_name = "Release: v#{version_tag}" # The name of the release.
    release_description = <<~RELEASE
        #{changelog_notes}

        **Full Changelog:** [View on GitLab](https://gitlab.com/paydock/bounded-contexts/mobile/mobile-sdk-ios/-/commits/#{version_tag})
    RELEASE

    # Define the release assets.
    # These are links to external resources related to the release.
    release_assets = [
        {
            "name" => "MobileSDK Documentation", # The name of the asset.
            "url" => "https://github.com/PayDock/mobile-sdk-doc/tree/main" # The URL of the asset.
        }
    ]

    # Construct the release data payload.
    # This is the data that will be sent to the GitLab API to create the release.
    release_data = {
        "name" => release_name, # The name of the release.
        "tag_name" => version_tag, # The tag name of the release.
        "description" => release_description, # The description of the release.
        "ref" => version_tag, # The reference (tag or branch) for the release.
        "assets" => { # The assets associated with the release.
            "links" => release_assets # The links to the assets.
        }
    }.to_json # Convert the data to JSON format.

    # Construct the correct API URL.
    # This is the URL that will be used to create the release via the GitLab API.
    api_url = "#{api_endpoint}/projects/#{project_id}/releases"

    # Create the release using the GitLab API. https://docs.gitlab.com/api/releases/
    # This uses the 'curl' command to send a POST request to the GitLab API.
    # --silent: Suppresses progress output.
    # --header: Specifies the headers for the request (Content-Type and PRIVATE-TOKEN).
    # --data: Specifies the data payload for the request (the release data in JSON format).
    # --request POST: Specifies that this is a POST request.
    response = sh("curl --silent --header 'Content-Type: application/json' --header 'PRIVATE-TOKEN: #{gitlab_token}' \
        --data '#{release_data}' \
        --request POST '#{api_url}'")

    # Output the GitLab API response for debugging purposes.
    puts "📢 GitLab API Response: #{response}"

    # Indicate that the GitLab release was created successfully.
    UI.success("✅ GitLab release created successfully: #{release_name}")
end

desc "Creates a release on GitHub"
lane :create_github_release do |options|
    # This lane automates the process of creating a release on GitHub.
    # It extracts the version name from the Git tag, authenticates with GitHub, and creates a new release.

    # Get the version tag using the unified helper function
    version_tag = get_version_tag(options)

    fastlane_require 'octokit' # Loads the Octokit library for interacting with the GitHub API.

    # Authenticate with GitHub (assuming GITHUB_TOKEN is set in your CI/CD variables).
    # Set up Octokit client.
    client = Octokit::Client.new(access_token: ENV['GITHUB_TOKEN']) # Creates an Octokit client.

    # Get release notes from CHANGELOG.md
    release_notes = get_release_notes(version_tag)

    # Create a release on GitHub.
    repo = 'PayDock/ios-mobile-sdk' # Replace with your GitHub repository
    release_name = "v#{version_tag}" # Creates the release name (e.g., "v1.0.0").
    release_body = <<~RELEASE
        #{release_notes}

        **Full Changelog:** [View on GitLab]( https://github.com/PayDock/ios-mobile-sdk/commits/#{version_tag})
    RELEASE

    release = client.create_release(repo, "#{version_tag}", { # Creates the release on GitHub.
      tag_name: "#{version_tag}", # Sets the tag name.
      name: release_name, # Sets the release name.
      body: release_body, # Sets the release body.
      is_generate_release_notes: false, # Disables automatic generation of release notes.
      make_latest: 'true' # Marks the release as the latest.
    })
    # The 'client.create_release' method is used to create the release.
end

# Gets the version tag using multiple fallback strategies.
#
# This function provides a unified way to determine the version across all lanes.
# It prioritizes current project version over existing tags to support tag creation.
# It tries multiple sources in order of preference and handles errors gracefully.
#
# Priority order:
# 1. Lane option (:version parameter)
# 2. CI environment variable (CI_COMMIT_TAG - for release lanes)
# 3. Xcode project version (current version - for tag creation)
# 4. Latest git tag (existing tags - fallback for local dev)
#
# @param options [Hash] Lane options that may contain a :version key
# @return [String] The version tag (without 'v' prefix), or "unknown" if none found
def get_version_tag(options = {})
    begin
        # 1. Check if version was passed as a lane option
        version_tag = options[:version]
        return version_tag.gsub(/^v/, '') if version_tag && !version_tag.empty?

        # 2. Check CI environment variable (set on release branch with tags)
        version_tag = ENV["CI_COMMIT_TAG"]
        return version_tag.gsub(/^v/, '') if version_tag && !version_tag.empty?

        # 3. Get Xcode project version (current project version for new releases)
        begin
            version_tag = get_version_number(
                xcodeproj: "ExampleApp/ExampleApp.xcodeproj",
                target: "ExampleApp",
                configuration: "Release (Sandbox)"
            )
            return version_tag.gsub(/^v/, '') if version_tag && !version_tag.empty?
        rescue => xcode_ex
            UI.message("⚠️ Could not get xcode version: #{xcode_ex.message}")
        end

        # 4. Fallback to latest git tag (for local development scenarios)
        begin
            git_tag = sh("git describe --tags --abbrev=0", log: false).strip
            return git_tag.gsub(/^v/, '') if git_tag && !git_tag.empty?
        rescue => git_ex
            UI.message("⚠️ No git tags found: #{git_ex.message}")
        end

        # 5. Final fallback
        UI.message("⚠️ Could not determine version from any source, using 'unknown'")
        return "unknown"

    rescue => ex
        UI.message("⚠️ Error in get_version_tag: #{ex.message}")
        return "unknown"
    end
end

# Extracts the release notes for a specific version from the CHANGELOG.md file.
#
# @param version [String] The version number to extract release notes for (e.g., "2.3.0").
# @return [String] The release notes for the specified version, or an empty string if no entry is found.
def get_release_notes(version)
    # Read the changelog file
    changelog_path = "CHANGELOG.md"
    changelog_content = File.read(changelog_path)
    match = changelog_content.match(/^##\s+\[#{Regexp.escape(version)}\].*?\n(.*?)(?=\n##\s+\[|\z)/m)
    if match
      return match[1].strip
    else
      UI.message("⚠️ No changelog entry found for version #{version}.")
      return "" # Return an empty string if no changelog entry is found
    end
end

# Extracts the changelog content for a specific version from a given changelog content string.
#
# This function is a helper function that is used by `get_release_notes`.
# It takes the entire changelog content as a string and the version to search for.
# It then uses a regular expression to find the section of the changelog that corresponds to the given version.
#
# @param changelog_content [String] The entire content of the changelog file as a string.
# @param version [String] The version number to extract changelog content for (e.g., "2.3.0").
# @return [String] The changelog content for the specified version, or a message indicating no entry was found.
def extract_changelog_for_version(changelog_content, version)
    match = changelog_content.match(/^##\s+\[#{Regexp.escape(version)}\].*?\n(.*?)(?=\n##\s+\[|\z)/m)
    if match
      return match[1].strip
    else
      return "No changelog entry found for version #{version}"
    end
end

# Ensures Firebase service account credentials are available as a file path.
# If the environment variable contains JSON content (not a file path), writes it to a temp file.
#
# @param env_var_name [String] The environment variable name (e.g., "FIREBASE_SERVICE_ACCOUNT_FILE")
# @return [String, nil] Path to the service account file, or nil if not set
def ensure_firebase_service_account_file(env_var_name)
  service_account_data = ENV[env_var_name]
  return nil unless service_account_data
  
  # Check if it's already a file path (exists and is a file)
  if File.exist?(service_account_data) && File.file?(service_account_data)
    UI.message("📄 Using Firebase service account file: #{service_account_data}")
    return service_account_data
  end
  
  # If it's not a file path, it's likely JSON content (from GitLab CI/CD variable)
  # Check if it looks like JSON (starts with { or [)
  if service_account_data.strip.start_with?("{") || service_account_data.strip.start_with?("[")
    UI.message("📝 Detected JSON content in #{env_var_name}, writing to temporary file...")
    
    # Create a temporary file
    require 'tempfile'
    temp_file = Tempfile.new(['firebase-service-account', '.json'])
    temp_file.write(service_account_data)
    temp_file.close
    
    file_path = temp_file.path
    UI.message("✅ Created temporary service account file: #{file_path}")
    
    # Store reference so file isn't garbage collected too early
    # Note: File will be cleaned up when process exits
    return file_path
  end
  
  # If it's neither a file nor JSON, return as-is (might be a path that doesn't exist yet)
  UI.important("⚠️ #{env_var_name} doesn't appear to be a file path or JSON content")
  return service_account_data
end

# Updates a GitLab CI/CD variable using the GitLab API
#
# @param options [Hash] Options hash containing:
#   - variable_key [String] The variable key (e.g., "BUILD_NUMBERS_STAGING")
#   - variable_value [String] The variable value (JSON string)
# @return [Boolean] True if successful, false otherwise
def update_gitlab_variable(options)
    variable_key = options[:variable_key]
    variable_value = options[:variable_value]
    
    # Check if we're in CI and have required environment variables
    unless ENV["CI"] && ENV["CI_PROJECT_ID"] && ENV["CI_SERVER_HOST"]
        UI.important("⚠️ Not in CI environment or missing CI variables, skipping GitLab variable update")
        return false
    end
    
    unless ENV["GITLAB_TOKEN"]
        UI.important("⚠️ GITLAB_TOKEN not set, skipping GitLab variable update")
        return false
    end
    
    project_id = ENV["CI_PROJECT_ID"]
    server_host = ENV["CI_SERVER_HOST"]
    api_token = ENV["GITLAB_TOKEN"]
    
    # GitLab API endpoint: PUT /projects/:id/variables/:key
    # URL-encode the variable key for the API path
    require 'net/http'
    require 'uri'
    require 'json'
    
    encoded_key = URI.encode_www_form_component(variable_key)
    api_url = "https://#{server_host}/api/v4/projects/#{project_id}/variables/#{encoded_key}"
    
    begin
        
        uri = URI(api_url)
        http = Net::HTTP.new(uri.host, uri.port)
        http.use_ssl = true
        
        request = Net::HTTP::Put.new(uri.path)
        request['PRIVATE-TOKEN'] = api_token
        request['Content-Type'] = 'application/json'
        request.body = {
            value: variable_value,
            protected: false
        }.to_json
        
        response = http.request(request)
        
        if response.code.to_i == 200 || response.code.to_i == 201
            UI.success("✅ Successfully updated GitLab CI/CD variable: #{variable_key}")
            return true
        else
            UI.important("⚠️ Failed to update GitLab variable #{variable_key}: #{response.code} #{response.message}")
            UI.important("Response: #{response.body}")
            return false
        end
    rescue => e
        UI.important("⚠️ Error updating GitLab variable #{variable_key}: #{e.message}")
        return false
    end
end

# Manages build numbers per version for iOS builds.
# Reads only from GitLab CI/CD variables (BUILD_NUMBERS_{ENVIRONMENT}).
# When a new version is detected, the build number resets to 1.
# For existing versions, the build number is incremented.
# Updates GitLab CI/CD variable BUILD_NUMBERS_{ENVIRONMENT}.
#
# @param options [Hash] Options hash containing:
#   - version [String] The version string (e.g., "2.0.0")
#   - environment [String] The environment name (e.g., "staging", "sandbox")
# @return [Hash] Hash with :version and :build_number
def manage_build_number(options)
    version = options[:version]
    environment = options[:environment]
    
    # Read existing build numbers from GitLab CI/CD variable
    build_numbers = {}
    gitlab_var_key = "BUILD_NUMBERS_#{environment.upcase}"
    if ENV[gitlab_var_key]
        begin
            gitlab_build_numbers = JSON.parse(ENV[gitlab_var_key])
            # Extract build numbers for this environment
            gitlab_build_numbers.each do |env, versions|
                if env == environment
                    build_numbers[environment] = versions.dup
                    UI.message("📥 Loaded build numbers from GitLab CI/CD variable: #{gitlab_var_key}")
                    break
                end
            end
        rescue JSON::ParserError => e
            UI.important("⚠️ Could not parse GitLab variable #{gitlab_var_key}: #{e.message}")
            UI.important("Starting with empty build numbers")
        end
    else
        UI.important("⚠️ GitLab variable #{gitlab_var_key} not found, starting with empty build numbers")
    end
    
    # Create environment key if it doesn't exist
    build_numbers[environment] ||= {}
    
    # Get or initialize build number for this version
    if build_numbers[environment][version]
        # Increment build number for existing version
        current_build = build_numbers[environment][version].to_i
        new_build = current_build + 1
        build_numbers[environment][version] = new_build
        UI.message("📦 Version #{version} (#{environment}): Incrementing build number #{current_build} → #{new_build}")
    else
        # New version, start at build number 1
        new_build = 1
        build_numbers[environment][version] = new_build
        UI.message("🆕 New version #{version} (#{environment}): Setting build number to #{new_build}")
    end
    
    # Update GitLab CI/CD variable
    environment_build_numbers = { environment => build_numbers[environment] }
    gitlab_var_value = JSON.generate(environment_build_numbers)
    update_gitlab_variable(
        variable_key: gitlab_var_key,
        variable_value: gitlab_var_value
    )
    
    UI.success("✅ Build number #{new_build} assigned to version #{version} (#{environment})")
    
    return { version: version, build_number: new_build }
end

# Reads the build number for a specific version and environment.
# Reads only from GitLab CI/CD variables (BUILD_NUMBERS_{ENVIRONMENT}).
#
# @param options [Hash] Options hash containing:
#   - version [String] The version string (e.g., "2.0.0")
#   - environment [String] The environment name (e.g., "staging", "sandbox")
# @return [Integer] The build number, or nil if not found
def get_build_number_from_file(options)
    version = options[:version]
    environment = options[:environment]
    
    # Read from GitLab CI/CD variable (source of truth)
    gitlab_var_key = "BUILD_NUMBERS_#{environment.upcase}"
    if ENV[gitlab_var_key]
        begin
            gitlab_build_numbers = JSON.parse(ENV[gitlab_var_key])
            build_number = gitlab_build_numbers.dig(environment, version)&.to_i
            if build_number
                UI.message("📥 Read build number from GitLab CI/CD variable: #{version} (#{build_number})")
                return build_number
            else
                UI.important("⚠️ Build number not found for version #{version} in #{gitlab_var_key}")
            end
        rescue JSON::ParserError => e
            UI.important("⚠️ Could not parse GitLab variable #{gitlab_var_key}: #{e.message}")
        end
    else
        UI.important("⚠️ GitLab variable #{gitlab_var_key} not found")
    end
    
    return nil
end

# Updates the Xcode project with the specified version and build number.
#
# @param options [Hash] Options hash containing:
#   - project [String] Path to the Xcode project
#   - target [String] Target name
#   - version [String] Version string
#   - build_number [Integer] Build number
def update_version_and_build_number(options)
    project = options[:project]
    target = options[:target]
    version = options[:version]
    build_number = options[:build_number]
    
    UI.message("📝 Updating #{target} to version #{version} build #{build_number}")
    
    # Update version number (CFBundleShortVersionString)
    increment_version_number(
        version_number: version,
        xcodeproj: project
    )
    
    # Update build number (CFBundleVersion)
    increment_build_number(
        build_number: build_number.to_s,
        xcodeproj: project
    )
    
    UI.success("✅ Updated to version #{version} (#{build_number})")
end

# Injects environment variables from GitLab CI/CD into an xcconfig file.
#
# This function reads environment variables with a specific suffix (e.g., _STAGING or _SANDBOX)
# and updates the corresponding variables in the xcconfig file.
#
# @param options [Hash] Options hash containing:
#   - xcconfig_path [String] Path to the xcconfig file to update
#   - env_suffix [String] Suffix to append to variable names when looking for environment variables
def inject_env_vars_to_xcconfig(options)
    xcconfig_path = options[:xcconfig_path]
    env_suffix = options[:env_suffix]
    
    # Check if file exists and initialize if needed
    unless File.exist?(xcconfig_path)
        UI.important("⚠️  xcconfig file not found at path: #{xcconfig_path}")
        UI.important("Creating xcconfig file with environment variables...")
        # Ensure directory exists
        FileUtils.mkdir_p(File.dirname(xcconfig_path))
        # Create empty file
        File.write(xcconfig_path, "// Auto-generated configuration file\n")
    end
    
    UI.message("Reading xcconfig file: #{xcconfig_path}")
    xcconfig_content = File.read(xcconfig_path)
    
    # Define the variables we want to inject from GitLab environment
    # Variables with environment-specific suffixes
    variables_with_suffix = [
        "ACCESS_TOKEN_API",
        "ACCESS_TOKEN_WIDGET",
        "SERVICE_ID_MPGS",
        "SERVICE_ID_MPGS_TEST",
        "SERVICE_ID_AFTERPAY",
        "SERVICE_ID_APPLE_PAY_MPGS",
        "SERVICE_ID_CLICK_TO_PAY",
        "SERVICE_ID_COLES_PAY",
        "SERVICE_ID_GPAYMENTS",
        "SERVICE_ID_PAYPAL",
        "SERVICE_ID_ZIP"
    ]
    
    # Generic variables that don't use environment suffixes
    generic_variables = [
        "MERCHANT_ID_APPLE_PAY",
        "WALLET_ID_COLES_PAY"
    ]
    
    updated = false
    
    # Process variables that need suffix
    variables_with_suffix.each do |var_name|
        # Look for environment variable with suffix (e.g., ACCESS_TOKEN_API_STAGING)
        env_var_name = "#{var_name}#{env_suffix}"
        env_value = ENV[env_var_name]
        
        if env_value && !env_value.empty?
            UI.message("Injecting #{env_var_name} -> #{var_name}")
            
            # Update or add the variable in xcconfig
            old_pattern = /^#{Regexp.escape(var_name)}=.*$/
            if xcconfig_content.match?(old_pattern)
                xcconfig_content.gsub!(old_pattern, "#{var_name}=#{env_value}")
                updated = true
            else
                # If variable doesn't exist, add it
                xcconfig_content += "\n#{var_name}=#{env_value}"
                updated = true
            end
        else
            UI.message("⚠️ Environment variable #{env_var_name} not found, skipping")
        end
    end
    
    # Process generic variables (without suffix)
    generic_variables.each do |var_name|
        # Look for environment variable without suffix (e.g., MERCHANT_ID_APPLE_PAY)
        env_value = ENV[var_name]
        
        if env_value && !env_value.empty?
            UI.message("Injecting #{var_name} -> #{var_name} (generic, no suffix)")
            
            # Update or add the variable in xcconfig
            old_pattern = /^#{Regexp.escape(var_name)}=.*$/
            if xcconfig_content.match?(old_pattern)
                xcconfig_content.gsub!(old_pattern, "#{var_name}=#{env_value}")
                updated = true
            else
                # If variable doesn't exist, add it
                xcconfig_content += "\n#{var_name}=#{env_value}"
                updated = true
            end
        else
            UI.message("⚠️ Environment variable #{var_name} not found, skipping")
        end
    end
    
    if updated
        UI.message("Writing updated xcconfig file: #{xcconfig_path}")
        File.write(xcconfig_path, xcconfig_content)
        UI.success("✅ Successfully injected environment variables into #{xcconfig_path}")
    else
        UI.message("No environment variables found to inject")
    end
end
